APP_NAME="MikroTik ISP Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Douala
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikrotik_isp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MIKROTIK_API_PORT=8728
MIKROTIK_SSL_PORT=8729
MIKROTIK_TIMEOUT=15
MIKROTIK_QUARANTINE_LIST=EXPIRED_USERS
# Remembered-login windows. Cookie lifetimes are login conveniences only —
# subscription expiry is enforced by disabling the RouterOS account.
MIKROTIK_MAC_COOKIE_TIMEOUT=30d
MIKROTIK_HTTP_COOKIE_LIFETIME=30d
MIKROTIK_IDLE_TIMEOUT=5m

# Monetbil Mobile Money gateway (https://www.monetbil.com)
# APP_URL must be the PUBLIC https URL of this app: it is used as the
# notify_url (webhook) and return_url sent to Monetbil.
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
MONETBIL_LOGO_URL=

